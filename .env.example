# -------------------------------------------------------------------
# Tankas — environment variables
# Copy to .env and fill in. Never commit .env.
# On Railway these are set as service variables instead.
# -------------------------------------------------------------------

# --- Database ---
# Railway: reference the Postgres service so the URL tracks it automatically:
#   DATABASE_URL=${{Postgres.DATABASE_URL}}
# Local docker-compose / container:
#   postgresql://postgres:postgres@localhost:5432/tankas
DATABASE_URL=

# TLS for the DB connection: require | prefer | disable.
# Leave blank to auto-detect — managed providers (Supabase, Koyeb, Neon) get
# TLS; Railway's private network (*.railway.internal) and localhost do not,
# because they terminate no TLS and will refuse the handshake.
DB_SSL=

DB_POOL_MIN=2
DB_POOL_MAX=10

# --- Auth ---
JWT_SECRET=

# --- Image storage ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- AI image analysis ---
# yolo = free, local, ships in the image (default)
# google_vision = paid, needs GOOGLE_VISION_CREDENTIALS_PATH
AI_PROVIDER=yolo
GOOGLE_VISION_CREDENTIALS_PATH=

# --- Payments ---
PAYSTACK_SECRET_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co

# --- Email ---
GMAIL_SENDER_EMAIL=
GMAIL_APP_PASSWORD=

# --- Email transport ---
# Resend (HTTPS) is used when RESEND_API_KEY is set, Gmail SMTP otherwise.
# Required in production on Railway: SMTP is blocked on Free/Trial/Hobby plans
# and fails with "[Errno 101] Network is unreachable".
# https://docs.railway.com/networking/outbound-networking
RESEND_API_KEY=
# Must be on a domain verified in Resend. The default below only delivers to
# the address that owns the Resend account.
RESEND_FROM=Tankas <onboarding@resend.dev>
